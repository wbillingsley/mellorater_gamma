# Copy to /etc/sysconfig/awserver (chmod 600, owned by root) and fill in real values.
# Referenced by deploy/awserver.service via EnvironmentFile=.

PORT=8081

# Where the built client lives (npm run build -> dist/), relative to WorkingDirectory in
# awserver.service unless given as an absolute path. The server serves it directly, so haproxy
# only needs to forward everything to this one process.
CLIENT_DIST_DIR=dist

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=mellorator
PGUSER=awserver
PGPASSWORD=changeme
PGPOOLSIZE=10

# The server now serves the client itself (same origin), so this isn't load-bearing for this
# deployment -- only needed if some other origin (e.g. a gh-pages build) also calls this API.
CORS_ALLOW_ORIGIN=https://example.com

# AI feedback: Claude is used if ANTHROPIC_API_KEY is set, with Groq as the fallback (if Claude
# fails, or its key is left blank). At least one of the two is needed for AI feedback.
ANTHROPIC_API_KEY=
# Optional: which Claude model and effort level to use (defaults: claude-sonnet-5-5, medium).
#CLAUDE_MODEL=claude-opus-5-5
#CLAUDE_EFFORT=low
GROQ_API_KEY=changeme
